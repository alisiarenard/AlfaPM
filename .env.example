# LLM Configuration (OpenAI-compatible API)
# Используется для AI-функций: PDF-отчёты спринтов, гуманизация задач в письме обзора спринта

# LLM API Key
LLM_API_KEY=your-llm-api-key-here

# LLM Model (default: gpt-4o-mini)
# Примеры: gpt-4o-mini, gpt-4o, claude-3-haiku, mistral-small
LLM_MODEL=gpt-4o-mini

# LLM Base URL (default: https://api.openai.com/v1)
# Используйте для альтернативных endpoint'ов:
# - Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment
# - Локальные модели (LM Studio, Ollama): http://localhost:1234/v1
LLM_URL=https://api.openai.com/v1

# Database
DATABASE_URL=your-database-url

# Session
SESSION_SECRET=your-session-secret

# Kaiten Integration
KAITEN_DOMAIN=your-company.kaiten.ru
KAITEN_API_KEY=your-kaiten-api-key

# Kaiten Frontend URL (для фронтенда, должен совпадать с KAITEN_DOMAIN)
# Vite требует префикс VITE_ для доступа к переменным на фронтенде
VITE_KAITEN_DOMAIN=your-company.kaiten.ru

# Контур.Толк Integration
# Документация: https://talk.kontur.ru/api/swagger
# Аутентификация: заголовок X-Auth-Token
KONTURTOLK_API_URL=https://your-company.kontur.ru/talk/api
KONTURTOLK_EMAIL=your-email@company.ru
KONTURTOLK_API_KEY=your-konturtolk-api-key
